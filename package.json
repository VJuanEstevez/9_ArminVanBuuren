{
  "name": "9_ArminVanBuuren",
  "version": "1.0.0",
  "private": true,
  "description": "Página de fan de Armin van Buuren: trayectoria, sesiones en directo y canciones imprescindibles.",
  "scripts": {
      "dev": "vite",
      "build": "vite build",
      "deploy": "pnpm run build && gh-pages -d dist",
      "lint:js": "oxlint src/",
      "lint:js:fix": "oxlint --fix src/",
      "lint:css": "stylelint \"src/**/*.css\"",
      "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
      "format": "oxfmt src/",
      "format:check": "oxfmt --check src/",
      "check": "pnpm run lint:js && pnpm run lint:css && pnpm run format:check",
      "fix": "pnpm run lint:js:fix && pnpm run lint:css:fix && pnpm run format"
    },
  "keywords": ["armin-van-buuren", "trance", "dj", "a-state-of-trance", "fan-page", "vite"],
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^8.3.8"
  }
}
